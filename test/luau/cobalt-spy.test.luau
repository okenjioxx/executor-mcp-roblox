-- Mock Roblox/Cobalt surfaces; execute the production adapter in official Luau.
local env = {}
local builtInTypeof = typeof
local function typeof(v) return type(v) == "table" and rawget(v, "__instance") and "Instance" or builtInTypeof(v) end
local function getgenv() return env end
local function tick() return 1700000000 end
local function compareinstances(a, b) return a == b end
local clearCount, loads = 0, 0
local function instance(name, cls) return { __instance = true, Name = name, ClassName = cls or "RemoteEvent", GetFullName = function() return "ReplicatedStorage." .. name end } end
local a, b = instance("Duplicate"), instance("Duplicate")
local game = { Remote = a }
local raknet = { add_send_hook = function() end, add_receive_hook = function() end, remove_send_hook = function() end, remove_receive_hook = function() end, is_enabled = function() return true end }
local function newCobalt(mode)
  local s = { Logs = { Incoming = {}, Outgoing = {} }, ExecutorSupport = { raknet = { IsWorking = true } }, IsUsingRakNetHooks = mode ~= "luau", PolarisCobaltPatched = true,
    FunctionForClasses = { Outgoing = { RemoteEvent = "FireServer", RemoteFunction = "InvokeServer" }, Incoming = { RemoteEvent = "OnClientEvent", RemoteFunction = "OnClientInvoke" } },
    CobaltPluginManager = { Registry = { Interceptors = { Global = {} } } } }
  s.ClearLogs = function() clearCount += 1 end
  s.Unload = function() s.Unloaded = true; env.Cobalt = nil; env.CobaltInitialized = false end
  s.PolarisCodeGen = { BuildCallCode = function(_, info) assert(info.Instance and info.Type and info.Arguments); return "-- generated by Cobalt" end }
  env.Cobalt = { shared = s }; return s
end
local actualLoadstring = loadstring
local function loadstring(source, chunk)
  if chunk then return function() loads += 1; newCobalt(env.__polarisCobaltMode) end end
  local fn, err = actualLoadstring(source)
  if fn then setfenv(fn, setmetatable({ game = game }, { __index = getfenv() })) end
  return fn, err
end
-- ADAPTER_INSERT
local assertions = 0
local function eq(actual, expected) assertions += 1; assert(actual == expected, tostring(actual) .. " ~= " .. tostring(expected)) end
local function emit(s, info, remote, direction)
  for _, cb in s.CobaltPluginManager.Registry.Interceptors.Global.All or {} do eq(cb(info, remote, direction), nil) end
end
local function info(args) return { Arguments = args or table.pack(1), CreationTime = tick(), IsRakNet = true } end
local function log(s, remote, direction)
  local l = { Instance = remote, Blocked = false, Ignored = false, Calls = {} }
  l.Block = function(self) self.Blocked = not self.Blocked end
  l.Ignore = function(self) self.Ignored = not self.Ignored end
  table.insert(s.Logs[direction], l); return l
end

eq(run("status", {}).loaded, false); eq(loads, 0)
eq(run("logs", {}).notRunning, true); eq(loads, 0)
env.__mcp_remoteSpy = { active = true }
eq(type(run("start", {}).error), "string"); eq(loads, 0)
env.__mcp_remoteSpy = nil
local started = run("start", { mode = "raknet", max = 10 }); eq(started.installed, true); eq(loads, 1)
local s = env.Cobalt.shared
local first = s.CobaltPluginManager.Registry.Interceptors.Global.All[1]
eq(run("start", {}).max, 10); eq(#s.CobaltPluginManager.Registry.Interceptors.Global.All, 1); eq(loads, 1)
eq(s.CobaltPluginManager.Registry.Interceptors.Global.All[1], first)
local cyclic = { value = "hello" }; cyclic.self = cyclic
local sample = info(table.pack(1, nil, false, cyclic, buffer.fromstring("\0\255"), "\255", nil))
sample.InvokeResult = table.pack(nil, "result"); sample.IsExecutor = false; sample.IsActor = true; sample.Actor = a
emit(s, sample, a, "Outgoing")
local result = run("logs", {}); local row = result.logs[1]
eq(row.argCount, 7); eq(#row.args, 7); eq(row.args[2].__type, "nil"); eq(row.args[3], false); eq(row.args[7].__type, "nil")
eq(row.args[5].hex, "00ff"); eq(row.args[6].binary, true); eq(row.args[6].hex, "ff")
eq(row.resultCount, 2); eq(row.results[1].__type, "nil"); eq(row.results[2], "result"); eq(row.isExecutor, false); eq(row.isActor, true)
sample.Arguments[1] = 900; eq(run("logs", {}).logs[1].args[1], 1)
local idA = row.remoteId
emit(s, info(), b, "Outgoing"); local idB = run("logs", {}).logs[1].remoteId; assert(idA ~= idB)
eq(type(run("control", { remotePath = "game.Remote", remoteId = idB, control = "block", enabled = true }).error), "string")
local outA, outB, inA = log(s, a, "Outgoing"), log(s, b, "Outgoing"), log(s, a, "Incoming")
eq(run("control", { remoteId = idA, direction = "Outgoing", control = "block", enabled = true }).blocked, true)
eq(outA.Blocked, true); eq(outB.Blocked, false); eq(inA.Blocked, false)
run("control", { remoteId = idA, direction = "Outgoing", control = "block", enabled = true }); eq(outA.Blocked, true)
eq(run("control", { remoteId = idA, direction = "Outgoing", control = "block", enabled = false }).blocked, false); eq(outA.Blocked, false)
run("control", { remotePath = "game.Remote", direction = "Incoming", control = "ignore", enabled = true }); eq(inA.Ignored, true); eq(outA.Ignored, false)
run("view-start", { view = "incoming", direction = "Incoming" })
emit(s, info(), a, "Outgoing"); emit(s, info(), a, "Incoming")
eq(#run("view-fetch", { view = "incoming" }).logs, 1)
eq(run("view-stop", { view = "incoming" }).captureContinues, true); eq(run("status", {}).active, true)
local functionSample = info(); functionSample.InvokeKind = "Request"; functionSample.Error = "failed"
emit(s, functionSample, a, "Incoming")
eq(run("logs", { direction = "Incoming", limit = 1 }).logs[1].error, "failed")
eq(run("logs", { direction = "Incoming", nameFilter = "duplic", raknetOnly = true }).matching, 2)
local latest = run("status", {}).latestId
eq(run("logs", { afterId = latest }).returned, 0)
eq(run("code", { callId = latest }).code, "-- generated by Cobalt")
run("clear", {}); eq(run("status", {}).count, 0); eq(clearCount, 1); eq(inA.Ignored, true)
for i = 1, 15 do emit(s, info(table.pack(i)), a, "Outgoing") end
local overflow = run("logs", { limit = 20, afterId = 1 })
eq(overflow.count, 10); eq(overflow.logs[1].args[1], 15); eq(overflow.logs[10].args[1], 6); eq(overflow.gap, true); eq(overflow.dropped, 5)
run("start", { max = 12 }); eq(run("status", {}).count, 10)
run("start", { max = 10 }); eq(run("status", {}).max, 10)
-- Ranking considers every retained call before applying limit.
run("clear", {})
for i = 1, 6 do emit(s, info(), a, "Outgoing") end
for i = 1, 2 do emit(s, info(), b, "Outgoing") end
local ranked = run("list", { limit = 1, summaryOnly = true }); eq(ranked.remotes[1].remoteId, idA); eq(ranked.remotes[1].totalCalls, 6); eq(ranked.truncated, true)
eq(run("start", { mode = "luau" }).restartRequired, true)
-- Invalid restart cannot unload the running spy.
raknet.is_enabled = function() return false end
eq(type(run("restart", { mode = "raknet" }).error), "string"); eq(run("status", {}).active, true)
raknet.is_enabled = function() return true end
local oldRegistry = s.CobaltPluginManager.Registry.Interceptors.Global.All
local restarted = run("restart", { mode = "luau", max = 10 }); eq(restarted.mode, "luau"); eq(restarted.count, 0); eq(#oldRegistry, 0); eq(loads, 2)
eq(run("view-fetch", { view = "incoming" }).notRunning, true)
eq(type(run("control", { remoteId = idA, control = "block", enabled = true }).error), "string")
emit(env.Cobalt.shared, info(), a, "Outgoing")
assert(run("logs", {}).logs[1].remoteId ~= idA)
eq(type(run("code", { callId = latest }).error), "string")
assert(run("status", {}).latestId > latest)
run("stop", {}); eq(run("status", {}).loaded, false); eq(run("status", {}).active, false)
-- Existing Cobalt is adopted without downloading/booting it.
newCobalt("raknet"); eq(run("start", {}).adoptedExisting, true); eq(loads, 2)
-- A malformed capture cannot escape the passive interceptor.
emit(env.Cobalt.shared, {}, nil, "Outgoing"); eq(run("status", {}).captureErrors, 1)
print("Cobalt adapter passed " .. assertions .. " assertions (mock Roblox/Cobalt).")
